# Copy to .env (git-ignored). Docker compose reads it from this folder; run.bat reads the real environment.

# Shared secret; callers send it as X-Internal-Token. Empty = no auth (local use only).
MINICPM_TOKEN=

# Ollama model tag. Q4_K_M is the default; :Q8_0 and :F16 also exist.
MINICPM_MODEL=hf.co/openbmb/MiniCPM5-1B-GGUF:Q4_K_M

# Port the service listens on (compose: the port published by the load balancer).
MINICPM_PORT=9130

# Compose only: API copies behind nginx, and requests Ollama runs at once.
MINICPM_REPLICAS=1
OLLAMA_NUM_PARALLEL=2

# run.bat only (compose sets these itself): bind address and where Ollama is.
# MINICPM_HOST=127.0.0.1
# OLLAMA_URL=http://127.0.0.1:11434
